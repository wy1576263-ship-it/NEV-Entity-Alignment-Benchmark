{
  "project_meta": {
    "name": "NEV_KGQA_Pipeline",
    "version": "2.1.2",
    "description": "Knowledge Graph QA for New Energy Vehicles",
    "last_update": "2026-04-16"
  },
  "environment": {
    "os": "Windows 10 (64-bit)",
    "hardware_platform": "Intel(R) Core(TM) i7-11850H",
    "gpu": "None (Inference validated on CPU)",
    "python_version": "3.8.10",
    "ide": "PyCharm Professional 2021",
    "dl_framework": "TensorFlow 2.6.0",
    "graph_database": "Neo4j-community 3.5.5",
    "random_seed": 42
  },
  "hyperparameters": {
    "BERT_BiLSTM_CRF": {
      "transformer_layers": 12,
      "learning_rate": 3e-5,
      "batch_size": 256,
      "epochs": 240,
      "description": "Encoder for multi-source NEV diagnostic text."
    },
    "TextCNN_Intent": {
      "kernel_sizes": [2, 3, 4],
      "filters": 128,
      "dropout_rate": 0.5
    }
  },
  "alignment_strategy": {
    "weights": {
      "alpha_dice": 0.70,
      "beta_cosine": 0.30
    },
    "note": "Weights are optimized for Chinese NEV terminology morphological (Dice) and semantic (BERT) fusion."
  }
}
